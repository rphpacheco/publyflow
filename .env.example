DATABASE_URL=postgresql://postgres:postgres@localhost:54329/publyflow
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/publyflow_test
# Non-superuser role for tests that must prove row-level security is
# enforced (the `postgres` superuser above bypasses RLS by design, so it
# can't be used for that). See docker/test-db-init/01-app-user.sql.
TEST_APP_DATABASE_URL=postgresql://app_user:app_user@localhost:54329/publyflow_test
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
JEV_API_KEY=
# Required to render any page. Transitional, development-only stand-in for
# auth/session (see src/lib/organization.ts's getDevOrganizationId()) --
# set it to a real organization id from your local database.
NEXT_PUBLIC_DEV_ORGANIZATION_ID=
# Required to create or edit a Proposal. Transitional, development-only
# stand-in for auth/session (see src/lib/organization.ts's getDevUserId())
# -- set it to a real user id (an organization_members row) from your local
# database.
NEXT_PUBLIC_DEV_USER_ID=
