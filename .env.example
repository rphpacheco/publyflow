DATABASE_URL=postgresql://postgres:postgres@localhost:54329/publyflow
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/publyflow_test
# Non-superuser role for tests that must prove row-level security is
# enforced (the `postgres` superuser above bypasses RLS by design, so it
# can't be used for that). See docker/test-db-init/01-app-user.sql.
TEST_APP_DATABASE_URL=postgresql://app_user:app_user@localhost:54329/publyflow_test
# Authentication (Supabase Auth; app data stays in DATABASE_URL).
# 1. Create a Supabase project for development (supabase.com).
# 2. Project Settings > API: copy the project URL and the anon/publishable key
#    into NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY, and the
#    service_role key into SUPABASE_SERVICE_ROLE_KEY (used only by
#    `pnpm provision-user`, never by the app).
# 3. Authentication > URL Configuration: add http://localhost:3000/auth/callback
#    (and any other dev port you use) to the Redirect URLs.
# 4. Authentication > Providers > Google: enable it with an OAuth client
#    (Google Cloud Console > Credentials) whose authorized redirect URI is the
#    callback URL Supabase shows on that screen.
# 5. Authentication > Providers > Email: keep "Confirm email" enabled. Session
#    resolution links a Supabase user to a `users` row by e-mail match, so an
#    unconfirmed e-mail must never be trusted for that link -- with
#    "Confirm email" off (and the anon key being public), anyone could sign
#    up with an existing member's address and take over that account.
# 6. Create accounts with `pnpm provision-user` (run it without arguments for usage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
JEV_API_KEY=
